<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/mediaLibraryFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.practicum.playlistmaker.search.presentation.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_searchFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>

    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.practicum.playlistmaker.mediaLibrary.presentation.MediaLibraryFragment"
        android:label="MediaLibraryFragment"
        tools:layout="@layout/fragment_media_library">

        <action
            android:id="@+id/action_mediaLibrary_to_player"
            app:destination="@id/playerFragment"/>
        <action
            android:id="@+id/action_mediaLibrary_to_newPlaylist"
            app:destination="@id/newPlaylistFragment" />
    </fragment>

    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.practicum.playlistmaker.mediaLibrary.presentation.NewPlaylistFragment"
        android:label="NewPlaylistFragment" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.practicum.playlistmaker.settings.presentation.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.practicum.playlistmaker.player.presentation.PlayerFragment"
        android:label="PlayerFragment"
        tools:layout="@layout/fragment_player">

        <action
            android:id="@+id/action_player_to_newPlaylist"
            app:destination="@id/newPlaylistFragment" />

        <argument
            android:name="track"
            app:argType="com.practicum.playlistmaker.search.domain.models.Track" />

    </fragment>
</navigation>